# 复制为 backend/.env.local 后按需修改（git 已忽略 .env.local）
# cp backend/.env.example backend/.env.local

# 培训宝 Legacy 接口签名密钥（入站校验 + 出库 saveCourses）
LEGACY_SIGNATURE_KEY_PXB=fn234gyty4542
LEGACY_SIGNATURE_KEY_TAOKE=adfdsrve34243

# 淘课 → 培训宝课程库推送（generateOrder / restoreByOrderCode）
PXB_SITE_URL=http://dev.91pxb.com
PXB_OUTBOUND_ENABLED=true
PXB_OUTBOUND_APP_ID=taoke

# 老站静态 CDN（attachments/、statics/ 等，对应 PHP TAOKE_CDN_SITE）
# 两种写法等价：Docker/OS 注入用 TAOKE_*；spring.config.import 文件内推荐 taoke.legacy-static.*
TAOKE_LEGACY_STATIC_CDN_BASE=https://cdn-static.taoke.com/taoke/
taoke.legacy-static.cdn-base=https://cdn-static.taoke.com/taoke/

# 老站主站根（u/ 路径，对应 PHP TKW_MAIN_SITE）
TAOKE_LEGACY_MAIN_SITE_BASE=https://www.taoke.com/
taoke.legacy-static.main-site-base=https://www.taoke.com/
