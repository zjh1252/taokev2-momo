{
  "name": "taoke-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "淘课网移动端 — uni-app CLI 模式 (Vue 3)",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=. uni -p mp-weixin",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin",
    "build:mp-weixin:dev": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin --mode development",
    "preview:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin --mode test",
    "dev:h5:test": "cross-env UNI_INPUT_DIR=. uni --mode test",
    "build:h5:test": "cross-env UNI_INPUT_DIR=. uni build --mode test",
    "build:mp-weixin:test": "cross-env UNI_INPUT_DIR=. uni build -p mp-weixin --mode test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4020920240930001",
    "@dcloudio/uni-components": "3.0.0-4020920240930001",
    "@dcloudio/uni-h5": "3.0.0-4020920240930001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4020920240930001",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/vite-plugin-uni": "3.0.0-4020920240930001",
    "cross-env": "^10.1.0",
    "sass": "^1.80.0",
    "vite": "5.4.11"
  }
}
