# H5 浏览器开发
VITE_API_BASE_URL=http://localhost:8080
# /statics 等前端静态资源；OSS 上传由 asset.js 解析至 PXB CDN
VITE_ASSET_BASE_URL=https://v2.taoke.com
VITE_PXB_VIDEO_CDN_URL=https://cdn5-pxb-videos.taoke.com

# 微信小程序 / App 真机
# API：localhost 在模拟器有时可用；真机联调请复制 .env.development.local.example 为 .env.development.local 并填局域网 IP
VITE_API_BASE_URL_NATIVE=http://localhost:8080
# OSS 上传图片走 PXB CDN（微信 image 不支持 HTTP localhost）
VITE_ASSET_BASE_URL_NATIVE=https://cdn5-pxb-videos.taoke.com

VITE_MOCK_SMS=true
VITE_LOG_LEVEL=info
