# 后端 API 地址（本地自启后端用 localhost；否则用共享开发机 10.0.14.20）
NEXT_PUBLIC_API_BASE_URL=http://10.0.14.20:8080

# CDN 资源地址（可选，v2 上传文件）
NEXT_PUBLIC_CDN_BASE_URL=

# 老站静态 CDN（attachments/、statics/images/trainers/ 等，对齐后端 TAOKE_LEGACY_STATIC_CDN_BASE）
# 本地/test：http://cdn.test.taoke.com/taoke/
# 生产：https://cdn-static.taoke.com/taoke/
NEXT_PUBLIC_LEGACY_STATIC_CDN_BASE=

# 老站主站（u/ 路径）
NEXT_PUBLIC_LEGACY_MAIN_SITE_BASE=
# 兼容旧变量：未配 MAIN_SITE 时作为 u/ 与部分旧路径兜底
NEXT_PUBLIC_LEGACY_ASSET_BASE_URL=https://www.taoke.com
