# 后端 API 地址（本地自启后端用 localhost；否则用共享开发机 10.0.14.20）
NEXT_PUBLIC_API_BASE_URL=http://10.0.14.20:8080

# CDN 资源地址（OSS 上传文件 CDN，对齐老站 cdn5-pxb-videos.taoke.com）
NEXT_PUBLIC_CDN_BASE_URL=https://cdn5-pxb-videos.taoke.com

# Next 构建产物 CDN 前缀（/_next/static、public）；未设则页面同源加载。构建期写入。
# 示例：https://cdn.test.taoke.com 或 https://cdn-static.taoke.com
# 启用前须保证该域名能回源或同步站点静态资源（含 /_next/static、/statics）
# NEXT_PUBLIC_ASSET_PREFIX=

# 老站静态 CDN（attachments/、statics/images/trainers/ 等，对齐后端 TAOKE_LEGACY_STATIC_CDN_BASE）
# 本地/test：http://cdn.test.taoke.com/taoke/
# 生产：https://cdn-static.taoke.com/taoke/
NEXT_PUBLIC_LEGACY_STATIC_CDN_BASE=

# 老站主站（u/ 路径）
NEXT_PUBLIC_LEGACY_MAIN_SITE_BASE=
# 兼容旧变量：未配 MAIN_SITE 时作为 u/ 与部分旧路径兜底
NEXT_PUBLIC_LEGACY_ASSET_BASE_URL=https://www.taoke.com

# 培训宝父页面根地址（iframe 高度回传用，不含路径）
# 本地：http://local.91pxb.com  生产：https://www.91pxb.com
NEXT_PUBLIC_PXB_BASE_URL=https://www.91pxb.com
