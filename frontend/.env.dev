# 后端 API 地址（共享开发机；本地自启后端时改为 http://localhost:8080）
NEXT_PUBLIC_API_BASE_URL=http://10.0.14.20:8080

# CDN 资源地址（OSS 上传文件 CDN，对齐老站 cdn5-pxb-videos.taoke.com）
NEXT_PUBLIC_CDN_BASE_URL=https://cdn5-pxb-videos.taoke.com

# Next 构建产物 CDN 前缀（可选；未设则同源）。示例：https://cdn.test.taoke.com
# NEXT_PUBLIC_ASSET_PREFIX=

# 老站静态 CDN（专家头像 attachments/、statics/images/trainers/）
NEXT_PUBLIC_LEGACY_STATIC_CDN_BASE=http://cdn.test.taoke.com/taoke/
NEXT_PUBLIC_LEGACY_MAIN_SITE_BASE=https://www.taoke.com/
# 旧库专家头像（attachments/u/ 等）从此域名加载
NEXT_PUBLIC_LEGACY_ASSET_BASE_URL=https://www.taoke.com

# 启用 Mock 短信验证码弹窗（test 环境开启）
NEXT_PUBLIC_MOCK_SMS=true
